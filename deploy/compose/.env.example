# Ортус · пример конфигурации локального стенда. Реальные секреты сюда не попадают.
# Значения — слот 0 (общий стенд интегратора, стандартные порты). Агенту — свой файл:
#   node deploy/compose/stand.mjs init --slot <N>   → .env в корне: ortus-s<N>, порты + 100 × N, API 8100+N, Vite 5200+N.
# Compose читает файл через --env-file .env; cmd/migrate и cmd/seed получают переменные от stand.mjs.

# --- Стенд compose ---
COMPOSE_PROJECT_NAME=ortus         # имя проекта: контейнеры, тома и сеть не пересекаются между слотами
POSTGRES_PORT=5432                 # control DB и tenant DB (одна инстанция в local)
PG_TEST_PORT=5433                  # postgres-test (профиль test, tmpfs)
MINIO_PORT=9000                    # S3 API MinIO
MINIO_CONSOLE_PORT=9001            # консоль MinIO
MAILPIT_UI_PORT=8025               # веб-интерфейс Mailpit
OTEL_GRPC_PORT=4317                # OTLP gRPC коллектора
OTEL_HTTP_PORT=4318                # OTLP HTTP коллектора
OTEL_HEALTH_PORT=13133             # health_check коллектора: GET / → 200
KEYCLOAK_PORT=8081                 # Keycloak (профиль keycloak)

# --- Приложение (api, worker; W0.09) ---
APP_ENV=dev                        # dev | e2e | prod; e2e принимает X-Test-Scenario
HTTP_ADDR=127.0.0.1:8080           # адрес API только на loopback; у агента 127.0.0.1:(8100 + slot)
AUTH_PROVIDER=dev                  # dev — вход учёткой из сида (urn:ortus:dev); oidc — Keycloak (W1.03)

# PostgreSQL
PG_SUPERUSER=ortus_admin           # суперпользователь контейнера: только роли и create database в dev
PG_SUPERPASS=change-me-local       # заглушка; реальный пароль — только в .env
CONTROL_DB_URL=postgres://ortus_api:change-me@localhost:5432/ortus_control?sslmode=disable   # DSN API (роль ortus_api, только DML)
TENANT_DB_HOST=localhost:5432      # хост tenant DB (в local — та же инстанция)
# Секрет tenant_routing.secret_ref = env:TENANT_DB_URL (сид): DSN пула API к tenant DB, роль ortus_api (только DML).
# Путь DSN заменяется на tenant_routing.database_name. Учётка мигратора в secret_ref не попадает.
TENANT_DB_URL=postgres://ortus_api:change-me@localhost:5432/?sslmode=disable
TENANT_DB_POOL_MAX=4            # на тенант; общий бюджет ниже
TENANT_DB_POOL_BUDGET=80        # на процесс
TENANT_DB_IDLE_TTL=5m              # закрытие простаивающего пула тенанта

# --- Роли БД (14-engineering: migrator / api_runtime / worker_runtime / provisioner) ---
PG_SUPER_URL=postgres://ortus_admin:change-me-local@localhost:5432/ortus_control?sslmode=disable   # dev: migrate roles ensure и create database в сиде
MIGRATOR_DB_URL=postgres://ortus_migrator:change-me@localhost:5432/ortus_control?sslmode=disable   # DSN cmd/migrate и cmd/seed (DDL)
PG_MIGRATOR_PASS=change-me         # пароль ortus_migrator (задаётся migrate roles ensure)
PG_API_PASS=change-me              # пароль ortus_api (= пароль в CONTROL_DB_URL)
PG_WORKER_PASS=change-me           # пароль ortus_worker
PG_PROVISIONER_PASS=change-me      # пароль ortus_provisioner (CREATEDB; W1.02)

# --- Тестовая база (профиль test) ---
TEST_DB_URL=postgres://ortus:ortus@127.0.0.1:5433/ortus_test?sslmode=disable   # docker compose ... --profile test up -d --wait postgres-test

# Объектное хранилище
S3_ENDPOINT=http://localhost:9000  # S3 API MinIO
S3_REGION=ru-local                 # регион подписи (MinIO принимает любой)
S3_BUCKET=ortus-files              # создаёт node deploy/compose/stand.mjs bucket (minio-init)
S3_ACCESS_KEY=ortus                # = MINIO_ROOT_USER
S3_SECRET_KEY=change-me-local      # = MINIO_ROOT_PASSWORD; заглушка
UPLOAD_URL_TTL=10m                 # срок presigned PUT
DOWNLOAD_URL_TTL=2m                # срок presigned GET

# --- Keycloak (профиль keycloak) ---
KC_ADMIN=admin                     # KC_BOOTSTRAP_ADMIN_USERNAME
KC_ADMIN_PASS=change-me-local      # KC_BOOTSTRAP_ADMIN_PASSWORD; заглушка

# OIDC
OIDC_ISSUER=http://localhost:8081/realms/ortus                       # realm клиентов (D-03)
OIDC_CLIENT_ID=ortus-web                                             # клиент BFF
OIDC_CLIENT_SECRET=change-me-local                                   # заглушка
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback                # у агента порт Vite 5200 + slot
OPERATOR_OIDC_ISSUER=http://localhost:8081/realms/ortus-operators    # realm операторов (D-03)

# Сессия BFF
SESSION_COOKIE_NAME=ortus_sid      # HttpOnly cookie сессии
SESSION_TTL=12h                    # срок сессии
ALLOWED_ORIGINS=http://localhost:5173   # проверка Origin на мутациях; у агента порт Vite

# Почта (Mailpit)
SMTP_HOST=localhost                # SMTP-ловушка
SMTP_PORT=1025                     # SMTP Mailpit (он же опубликованный порт)

# Наблюдаемость
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317   # OTLP gRPC коллектора
LOG_LEVEL=debug                    # уровень log/slog

# Продуктовые параметры-гипотезы (PLAT-03, не тариф)
TRIAL_DAYS=14                      # длительность пробного периода
TRIAL_SEATS=10                     # мест в пробном периоде
TRIAL_STORAGE_BYTES=5368709120   # 5 ГиБ
GRACE_DAYS=7                       # льготный период
HOLD_TTL=15m                       # удержание брони машины
