{
  "name": "ortus-crm",
  "version": "0.0.0",
  "private": true,
  "description": "Ортус CRM — монорепозиторий: frontend (pnpm workspace) и backend (Go)",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "lint": "pnpm run format:check && pnpm run lint:js && pnpm run lint:go",
    "lint:js": "eslint .",
    "lint:go": "cd backend && golangci-lint run ./...",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run test:repo && pnpm run test:ci && pnpm run test:tools && pnpm run test:stand && pnpm run test:contract && pnpm -r --if-present run test && pnpm run test:go",
    "test:repo": "node --test \"tools/repo/*.test.mjs\"",
    "test:ci": "node --test \"tools/ci/*.test.mjs\"",
    "test:tools": "node --test \"tools/__tests__/*.test.mjs\"",
    "ci:local": "node tools/ci/pipeline.mjs --all",
    "ci:job": "node tools/ci/pipeline.mjs --job",
    "test:go": "go -C backend test ./...",
    "test:isolation": "go -C backend test -tags isolation -count=1 ./test/isolation/...",
    "test:contract": "node --test \"tools/gen/*.test.mjs\"",
    "contract": "node tools/gen/contract.mjs",
    "contract:check": "node tools/gen/contract.mjs --check",
    "lint:api": "spectral lint api/dist/ortus.bundle.yaml --ruleset api/.spectral.yaml --fail-severity error",
    "validate:api": "node tools/gen/contract.mjs --check",
    "build": "pnpm -r --if-present run build && go -C backend build ./...",
    "dev": "pnpm --filter @ortus/web run dev",
    "e2e": "pnpm --filter @ortus/web run e2e",
    "e2e:harness": "pnpm --filter @ortus/web run e2e:harness",
    "e2e:install": "pnpm --filter @ortus/e2e-kit run browsers:install",
    "mcp:install": "pnpm --filter @ortus/e2e-kit run mcp:install",
    "mcp:check": "node tools/mcp-check.js",
    "verify-pages": "node tools/verify-pages.js",
    "allowlist-lint": "node tools/allowlist-lint.js",
    "reference": "node tools/design-preview.js design 4173 --offline",
    "gen": "node tools/repo/stub-target.mjs gen W0.09",
    "up": "node deploy/compose/stand.mjs up",
    "down": "node deploy/compose/stand.mjs down",
    "migrate": "node deploy/compose/stand.mjs migrate",
    "seed": "node deploy/compose/stand.mjs seed",
    "test:stand": "node --test deploy/compose/stand.test.mjs",
    "examples": "node tools/repo/stub-target.mjs examples W0.13",
    "prepare": "husky"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "@scarf/scarf"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@stoplight/spectral-cli": "6.17.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pnpm": "9.15.9",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
