{
  "$description": "Ортус · дизайн-токены v0.2 (01.10.2026). Формат W3C Design Tokens. Источник для packages/tokens → CSS custom properties и TS.",
  "color": {
    "$type": "color",
    "canvas":        { "$value": "#E6E9E3", "$description": "Фон вокруг приложения, демо-рамка" },
    "surface":       { "$value": "#F2F3EF", "$description": "Фон рабочей области" },
    "card":          { "$value": "#FFFFFF" },
    "raised":        { "$value": "#F8F9F6", "$description": "Вложенные блоки, подсказки" },
    "line":          { "$value": "#DCE2D9", "$description": "Границы карточек" },
    "line-control":  { "$value": "#CDD5CB", "$description": "Границы полей и вторичных кнопок" },
    "divider":       { "$value": "#E8ECE5" },
    "text":          { "$value": "#1C2A26" },
    "text-label":    { "$value": "#3A4844" },
    "text-muted":    { "$value": "#5C6964", "$description": "Вторичный текст; 5.6:1 на белом" },
    "accent":        { "$value": "#1F6B52" },
    "accent-hover":  { "$value": "#185A44" },
    "accent-soft":   { "$value": "#E3EFE7" },
    "on-accent":     { "$value": "#FFFFFF" },
    "chrome":        { "$value": "#22302C", "$description": "Тёмная шапка оператора платформы и демо-панель" },
    "focus":         { "$value": "#1F6B52" },
    "tone": {
      "ok":      { "bg": { "$value": "#E3EFE7" }, "fg": { "$value": "#1F6B52" }, "border": { "$value": "#B9D6C4" } },
      "info":    { "bg": { "$value": "#E7EEF6" }, "fg": { "$value": "#2B5479" }, "border": { "$value": "#C3D3E6" } },
      "warn":    { "bg": { "$value": "#FAF1DC" }, "fg": { "$value": "#7A5214" }, "border": { "$value": "#EBD7A6" } },
      "danger":  { "bg": { "$value": "#FBEAE7" }, "fg": { "$value": "#A13A33" }, "border": { "$value": "#F0C9C3" } },
      "neutral": { "bg": { "$value": "#ECEFEA" }, "fg": { "$value": "#4C5955" }, "border": { "$value": "#D5DBD2" } }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Golos Text", "system-ui", "sans-serif"] },
      "mono": { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Госномера, ключи прав, ID запроса" }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "12px" }, "sm": { "$value": "13px" }, "md": { "$value": "14px" },
      "lg": { "$value": "16px" }, "xl": { "$value": "20px" }, "2xl": { "$value": "24px" }, "3xl": { "$value": "32px" }
    },
    "weight": { "$type": "fontWeight", "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } },
    "line-height": { "$type": "number", "tight": { "$value": 1.2 }, "base": { "$value": 1.45 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "5": { "$value": "20px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "10": { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" }, "md": { "$value": "8px" }, "lg": { "$value": "10px" }, "xl": { "$value": "12px" }, "pill": { "$value": "999px" }
  },
  "shadow": {
    "$type": "shadow",
    "popover": { "$value": "0 16px 40px rgba(28,42,38,.18)" },
    "dialog":  { "$value": "0 24px 64px rgba(28,42,38,.24)" },
    "sticky":  { "$value": "0 -8px 24px rgba(28,42,38,.08)" }
  },
  "size": {
    "$type": "dimension",
    "control":        { "$value": "44px", "$description": "Минимальная высота кнопок и полей на любом экране" },
    "control-mobile": { "$value": "48px", "$description": "Основное действие сотрудника на телефоне — 48–54px" },
    "control-compact":{ "$value": "32px", "$description": "Только в плотных таблицах на desktop" },
    "icon":           { "$value": "20px" },
    "header":         { "$value": "58px" }
  },
  "breakpoint": {
    "$type": "dimension",
    "rail":    { "$value": "640px",  "$description": "< 640 — нижняя навигация и карточки вместо таблиц" },
    "sidebar": { "$value": "1080px", "$description": "≥ 1080 — боковая панель с подписями" }
  },
  "motion": {
    "$type": "duration",
    "fast": { "$value": "120ms" }, "base": { "$value": "200ms" },
    "$description": "prefers-reduced-motion: reduce → 0ms, кроме индикаторов прогресса"
  },
  "icon": {
    "set": { "$value": "Material Symbols Rounded", "$description": "opsz 24, wght 400, FILL 0; FILL 1 — только для активного пункта меню" }
  }
}
