# Ортус · пример конфигурации локального стенда. Реальные секреты сюда не попадают.

# PostgreSQL
PG_SUPERUSER=ortus_admin
PG_SUPERPASS=change-me-local
CONTROL_DB_URL=postgres://ortus_api:change-me@localhost:5432/ortus_control?sslmode=disable
TENANT_DB_HOST=localhost:5432
TENANT_DB_POOL_MAX=4            # на тенант; общий бюджет ниже
TENANT_DB_POOL_BUDGET=80        # на процесс
TENANT_DB_IDLE_TTL=5m

# Объектное хранилище
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-local
S3_BUCKET=ortus-files
S3_ACCESS_KEY=ortus
S3_SECRET_KEY=change-me-local
UPLOAD_URL_TTL=10m
DOWNLOAD_URL_TTL=2m

# OIDC
OIDC_ISSUER=http://localhost:8081/realms/ortus
OIDC_CLIENT_ID=ortus-web
OIDC_CLIENT_SECRET=change-me-local
OIDC_REDIRECT_URL=http://localhost:5173/auth/callback
OPERATOR_OIDC_ISSUER=http://localhost:8081/realms/ortus-operators

# Сессия BFF
SESSION_COOKIE_NAME=ortus_sid
SESSION_TTL=12h
ALLOWED_ORIGINS=http://localhost:5173

# Почта (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# Наблюдаемость
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=debug

# Продуктовые параметры-гипотезы (PLAT-03, не тариф)
TRIAL_DAYS=14
TRIAL_SEATS=10
TRIAL_STORAGE_BYTES=5368709120   # 5 ГиБ
GRACE_DAYS=7
HOLD_TTL=15m
